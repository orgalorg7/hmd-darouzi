# Set only after purchasing and deploying the final domain. No trailing path.
# SITE_URL=https://your-purchased-domain.com
# Optional Search Console HTML verification token; DNS domain verification also works.
# GOOGLE_SITE_VERIFICATION=
# Optional, preview builds only: the current tunnel/preview HTTPS origin, so WhatsApp and other apps can load
# the link-preview card images. Pages stay noindex. Not needed once SITE_URL is set.
# PREVIEW_URL=https://example.trycloudflare.com
# Set to 1 in the production hosting environment to reject builds without SITE_URL.
# SEO_REQUIRE_DOMAIN=1
